<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="card-header bg-primary text-white py-4">
                    <h2 class="h4 mb-1">Add New Todo</h2>
                    <p class="mb-0 text-white-50">Create a new task and keep your workflow organized</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form action="/todos/new" method="POST">
                        <div class="mb-4">
                            <label for="title" class="form-label fw-semibold">Title</label>
                            <input type="text" class="form-control form-control-lg" id="title" name="title"
                                placeholder="Example: Finish Node.js assignment" required>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="4"
                                placeholder="Add useful details for this task" required></textarea>
                            <div class="form-text">Keep it short and actionable.</div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary px-4">Add Todo</button>
                            <a href="/" class="btn btn-outline-secondary px-4">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>